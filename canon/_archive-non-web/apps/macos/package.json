{
  "name": "TrainingAppMac",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "scripts/android-release.sh",
    "dev": "node ./scripts/dev.mjs",
    "ios": "react-native run-ios",
    "lint": "ESLINT_USE_FLAT_CONFIG=false ./node_modules/.bin/eslint --ext .js,.ts,.tsx .",
    "macos": "react-native run-macos",
    "pods:macos": "pod install --project-directory=macos",
    "start": "react-native start",
    "start:macos": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "android": {
    "versionCode": 1
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@training/shared": "file:../../packages/shared",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-macos": "^0.76.12",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
