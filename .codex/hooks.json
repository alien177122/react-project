{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/steve_gordiyenko/Desktop/React_Project_Журнал_Сплит/.codex/hooks/block-sensitive-edits.mjs'"
          }
        ]
      },
      {
        "matcher": "mcp__sqlite__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/steve_gordiyenko/Desktop/React_Project_Журнал_Сплит/.codex/hooks/guard-sqlite-mcp.mjs'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/steve_gordiyenko/Desktop/React_Project_Журнал_Сплит/.codex/hooks/format-edited-file.mjs'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
