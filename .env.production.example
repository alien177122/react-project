# Production frontend environment for Vercel.
# Copy to your Vercel Project → Settings → Environment Variables BEFORE running build.
# Vite inlines `import.meta.env.VITE_*` values at build time — env added after the
# build runs has zero effect on the deployed bundle.

# URL of the deployed Express+SQLite API. Trailing slash optional, no trailing space.
# Without this, the built frontend falls back to '/api' and Vercel returns 404 for
# every API call.
VITE_API_URL=https://your-api.example.com/api
