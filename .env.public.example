# Copy this file to .env.public and fill in the values below.
# .env.public is loaded automatically by npm run public, npm run public:stable and launchd scripts.

JWT_SECRET=replace-with-a-long-random-secret
# Must match the local service URL you configure in the Cloudflare tunnel route.
PUBLIC_PORT=3001

# Browser origins allowed to call the API (your public hostname + local Vite).
CORS_ORIGINS=https://app.example.com,http://localhost:5173
# Keep off on public tunnel unless you intentionally expose OCR inbox.
ENABLE_FILE_WORKSPACE=0
# Never set SEED_JOURNAL_DEMO=1 on public/production (known demo password).

# Stable public URL via Cloudflare Tunnel.
# Create a named tunnel in Cloudflare Zero Trust and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
PUBLIC_HOSTNAME=app.example.com

# Optional: auto-send quick-tunnel URL to Telegram after `npm run tunnel:quick`.
# Create a bot via @BotFather, message it once, then set chat id (e.g. @userinfobot).
# Cursor has no native Telegram app link — Bot API only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
