# Fastlane — автоматизация сборки и публикации Training Calculator (Capacitor)
# Документация: https://docs.fastlane.tools
# Метрики отключены (opt_out_usage). Альтернатива: FASTLANE_OPT_OUT_USAGE=YES

PROJECT_ROOT = File.expand_path("..", __dir__)

opt_out_usage

default_platform(:ios)

before_all do
  ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
  Dir.chdir(PROJECT_ROOT)
end

platform :ios do
  desc "Показать метаданные iOS-проекта (демо, без сборки)"
  lane :info do
    UI.header("Training Calculator — iOS")
    UI.success("Bundle ID: com.stevegordiyenko.trainingcalculator")
    UI.message("Workspace: ios/App/App.xcworkspace")
    UI.message("Scheme: App")
    UI.message("Capacitor sync: npm run cap:sync")

    version = get_version_number(
      xcodeproj: File.join(PROJECT_ROOT, "ios/App/App.xcodeproj"),
      target: "App"
    )
    build = get_build_number(xcodeproj: File.join(PROJECT_ROOT, "ios/App/App.xcodeproj"))
    UI.important("Version: #{version} (#{build})")
  end

  desc "Синхронизировать web-сборку Vite → iOS (без pod install)"
  lane :sync do
    sh("npm run build")
    sh("npx cap copy ios")
  end

  desc "Собрать Debug без подписи (локальная проверка пайплайна)"
  lane :build_debug do
    sync
    build_app(
      workspace: File.join(PROJECT_ROOT, "ios/App/App.xcworkspace"),
      scheme: "App",
      configuration: "Debug",
      skip_codesigning: true,
      skip_package_ipa: true,
      destination: "generic/platform=iOS Simulator"
    )
    UI.success("Debug build завершён (без IPA и без codesign)")
  end
end

platform :android do
  desc "Показать метаданные Android-проекта (демо)"
  lane :info do
    UI.header("Training Calculator — Android")
    UI.success("Application ID: com.stevegordiyenko.trainingcalculator")
    UI.message("Gradle project: android/")
    UI.message("Debug APK: android/app/build/outputs/apk/debug/")
  end

  desc "Собрать debug APK через Gradle"
  lane :build_debug do
    sh("npm run build")
    sh("npx cap sync android")
    gradle(
      task: "assembleDebug",
      project_dir: File.join(PROJECT_ROOT, "android")
    )
    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.success("APK: #{apk}") if apk
  end
end
