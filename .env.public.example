# Copy this file to .env.public and fill in the values below.
# .env.public is loaded automatically by npm run public, npm run public:stable and launchd scripts.

JWT_SECRET=replace-with-a-long-random-secret
# Must match the local service URL you configure in the Cloudflare tunnel route.
PUBLIC_PORT=3001

# Stable public URL via Cloudflare Tunnel.
# Create a named tunnel in Cloudflare Zero Trust and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
PUBLIC_HOSTNAME=app.example.com
