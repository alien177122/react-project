JWT_SECRET=replace-with-a-long-random-secret
APP_PORT=3001
# Comma-separated browser origins allowed to call the API (no *).
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# Shared file workspace is off by default in Docker/production.
ENABLE_FILE_WORKSPACE=0
AUTH_RATE_LIMIT_WINDOW_MS=600000
LOGIN_MAX_ATTEMPTS=7
REGISTER_MAX_ATTEMPTS=5
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_OCR_MODEL=glm-ocr

# Optional: Telegram Bot API notify for quick-tunnel URL (prefer .env.public).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
