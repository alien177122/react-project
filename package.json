{
  "name": "react-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.6.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:dir": "node scripts/desktop-build.mjs --dir",
    "desktop:pack": "node scripts/desktop-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server/index.js",
    "public": "node scripts/public-run.mjs",
    "public:quick": "node scripts/public-run.mjs --quick",
    "public:stable": "node scripts/public-run.mjs --stable",
    "public:status": "node scripts/public-status.mjs",
    "public:launchd:install": "node scripts/public-launchd-install.mjs",
    "public:launchd:remove": "node scripts/public-launchd-remove.mjs",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f app",
    "docker:status": "docker compose --env-file .env.docker ps",
    "files:status": "node scripts/files-status.mjs",
    "files:analyze": "node scripts/files-analyze.mjs",
    "files:watch": "node scripts/files-watch.mjs",
    "ollama:pull-glm-ocr": "ollama pull glm-ocr",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "dependencies": {
    "@training/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.stevegordiyenko.trainingcalculator",
    "productName": "Training Calculator",
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
