# Capacitor native shell — copy to .env.capacitor.local and source before build/sync.
#
# Required for device/simulator API calls (native cannot use relative /api):
# VITE_API_URL=http://127.0.0.1:3002/api
#
# Android emulator → host machine:
# VITE_API_URL=http://10.0.2.2:3002/api
#
# Physical device on LAN (replace with your Mac IP):
# VITE_API_URL=http://192.168.1.100:3002/api
# Example (this Mac, 2026-06-21): http://192.168.18.22:3002/api
#
# Live reload during native dev (optional — points WebView at Vite):
# CAP_DEV_SERVER_URL=http://192.168.1.100:5173

VITE_API_URL=http://127.0.0.1:3002/api
