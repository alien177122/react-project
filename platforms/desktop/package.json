{
  "name": "@training/desktop",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "pack": "node scripts/desktop-build.mjs",
    "dir": "node scripts/desktop-build.mjs --dir"
  },
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.stevegordiyenko.trainingcalculator",
    "productName": "Training Calculator",
    "directories": {
      "output": "../../desktop-dist"
    },
    "files": [
      "../../dist/**/*",
      "../../server/**/*",
      "electron/**/*",
      "../../package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
